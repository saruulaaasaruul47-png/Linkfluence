{
  "name": "backend",
  "version": "1.0.0",
  "description": "Influence Hub modular monolith API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/integration/*.test.js tests/unit/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1 tests/integration/*.test.js tests/unit/*.test.js",
    "check": "npm run prisma:validate && npm run test",
    "seed:admin": "node prisma/seed-admin.js",
    "seed:demo-accounts": "node prisma/seed-demo-accounts.js",
    "seed:marketplace": "node prisma/seed-marketplace.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "worker:outbox": "node src/workers/outbox.js",
    "job:reconcile": "node scripts/reconcile-payments.js",
    "job:lifecycle": "node scripts/process-collaboration-lifecycle.js",
    "job:social-sync": "node scripts/sync-stale-social.js",
    "job:maintenance": "node scripts/run-maintenance-jobs.js",
    "smoke:p95": "node scripts/p95-smoke.js",
    "test:cursor-10k": "node scripts/verify-marketplace-cursor.js",
    "db:backup": "node scripts/backup-database.js",
    "db:restore": "node scripts/restore-database.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/node": "^10.70.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.1",
    "google-auth-library": "^11.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "resend": "^6.18.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
