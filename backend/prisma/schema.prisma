  rating          Int
  comment         String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  reviewer      User          @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Restrict)
  subject       User          @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([collaborationId, reviewerId])
  @@index([subjectId, publishedAt])
}

model TrustCase {
  id              String          @id @default(cuid())
  kind            TrustCaseKind
  status          TrustCaseStatus @default(OPEN)
  priority        Int             @default(0)
  reporterId      String?
  assignedAdminId String?
  targetType      String
  targetId        String
  reason          String
  evidence        Json?
  resolution      String?
  resolutionData  Json?
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reporter      User? @relation("CaseReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignedAdmin User? @relation("CaseAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([kind, status, priority])
  @@index([targetType, targetId])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  userId       String?
  name         String
  sessionId    String?
  resourceType String?
  resourceId   String?
  properties   Json?
  occurredAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, occurredAt])
  @@index([resourceType, resourceId, occurredAt])
  @@index([userId, occurredAt])
}

model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User @relation("AdminActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  userGrants  UserPermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  grantedById  String?
  createdAt    DateTime @default(now())

  user       User       @relation("PermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([permissionId, createdAt])
  @@index([grantedById, createdAt])
}

// Non-secret operational configuration. Secrets remain environment variables
// and are deliberately not represented by this model or its admin API.
model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("PlatformSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model FeatureFlag {
  id                String     @id @default(cuid())
  key               String     @unique
  name              String
  description       String?
  enabled           Boolean    @default(true)
  rolloutPercentage Int        @default(100)
  allowedRoles      UserRole[] @default([])
  updatedById       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  updatedBy User? @relation("FeatureFlagUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled, updatedAt])
}

model JobLease {
  name      String   @id
  ownerId   String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model JobRun {
  id         String       @id @default(cuid())
  jobName    String
  ownerId    String
  status     JobRunStatus @default(RUNNING)
  attempt    Int          @default(1)
  metrics    Json?
  error      String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([jobName, startedAt])
  @@index([status, startedAt])
}

model AnalyticsDailyRollup {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

