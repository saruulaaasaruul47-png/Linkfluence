  @@index([creatorId, status, createdAt])
  @@index([businessId, status, createdAt])
}

// Finance, reviews, trust and analytics

model Payment {
  id                   String                   @id @default(cuid())
  collaborationId      String
  parentId             String?
  type                 PaymentType
  compensationType     CollaborationPaymentType @default(PAID)
  status               PaymentStatus            @default(PENDING)
  amount               Decimal                  @db.Decimal(18, 2)
  cashAmount           Decimal                  @default(0) @db.Decimal(18, 2)
  barterEstimatedValue Decimal?                 @db.Decimal(18, 2)
  commissionRate       Decimal                  @default(0) @db.Decimal(7, 4)
  commissionAmount     Decimal                  @default(0) @db.Decimal(18, 2)
  creatorAmount        Decimal                  @default(0) @db.Decimal(18, 2)
  platformFee          Decimal                  @default(0) @db.Decimal(18, 2)
  currency             String                   @default("MNT")
  provider             String?
  providerRef          String?                  @unique
  idempotencyKey       String?                  @unique
  paymentMethodRef     String?
  failureReason        String?
  metadata             Json?
  processedAt          DateTime?
  fundedAt             DateTime?
  releasedAt           DateTime?
  refundedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  collaboration   Collaboration          @relation(fields: [collaborationId], references: [id], onDelete: Restrict)
  parent          Payment?               @relation("PaymentAdjustments", fields: [parentId], references: [id], onDelete: SetNull)
  adjustments     Payment[]              @relation("PaymentAdjustments")
  providerEvents  PaymentProviderEvent[]
  refundRequests  PaymentRefund[]
  payoutRequests  PaymentPayout[]
  ledgerEntries   LedgerEntry[]
  platformRevenue PlatformRevenue?

  @@index([collaborationId, type, status])
  @@index([status, createdAt])
}

model PaymentProviderEvent {
  id              String    @id @default(cuid())
  providerEventId String    @unique
  paymentId       String?
  walletTopUpId   String?
  provider        String
  eventType       String
  payload         Json
  payloadHash     String
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime  @default(now())

  payment     Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  walletTopUp WalletTopUp? @relation(fields: [walletTopUpId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([walletTopUpId, createdAt])
  @@index([eventType, createdAt])
}

model WalletTopUp {
  id             String            @id @default(cuid())
  userId         String
  amount         Decimal           @db.Decimal(18, 2)
  currency       String            @default("MNT")
  status         WalletTopUpStatus @default(PENDING)
  provider       String
  providerRef    String?           @unique
  idempotencyKey String            @unique
  metadata       Json?
  failureReason  String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  providerEvents PaymentProviderEvent[]

  @@index([userId, status, createdAt])
}

model PlatformRevenue {
  id              String                @id @default(cuid())
  paymentId       String?               @unique
  collaborationId String
  source          PlatformRevenueSource
  status          PlatformRevenueStatus @default(PENDING)
  amount          Decimal               @db.Decimal(18, 2)
  currency        String                @default("MNT")
  earnedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Restrict)

  @@index([status, source, createdAt])
  @@index([collaborationId])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  tokenRef  String   @unique
  brand     String?
  last4     String?
  expMonth  Int?
  expYear   Int?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
}

model PaymentRefund {
  id          String        @id @default(cuid())
  paymentId   String
  requesterId String
  amount      Decimal       @db.Decimal(18, 2)
  reason      String
  status      PaymentStatus @default(PENDING)
  providerRef String?       @unique
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requester User    @relation(fields: [requesterId], references: [id], onDelete: Restrict)

  @@index([paymentId, status])
}

model PaymentPayout {
  id              String        @id @default(cuid())
  paymentId       String
  creatorId       String
  payoutAccountId String?
  amount          Decimal       @db.Decimal(18, 2)
  status          PaymentStatus @default(PENDING)
  providerRef     String?       @unique
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  payoutAccount PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)

  @@index([creatorId, status])
  @@index([payoutAccountId, status])
}

model PayoutAccount {
  id                     String    @id @default(cuid())
  userId                 String
  provider               String
  accountName            String
  accountNumberEncrypted String    @db.Text
  bankCode               String?
  last4                  String
  currency               String    @default("MNT")
  isDefault              Boolean   @default(false)
  verifiedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts PaymentPayout[]

  @@index([userId, isDefault])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  ownerId   String?
  code      String            @unique
  type      LedgerAccountType
  currency  String            @default("MNT")
  balance   Decimal           @default(0) @db.Decimal(18, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  debitEntries  LedgerEntry[] @relation("LedgerDebitAccount")
  creditEntries LedgerEntry[] @relation("LedgerCreditAccount")

  @@unique([ownerId, type, currency])
  @@index([type, currency])
}

model LedgerEntry {
  id              String          @id @default(cuid())
  debitAccountId  String
  creditAccountId String
  collaborationId String?
  paymentId       String?
  type            LedgerEntryType
  amount          Decimal         @db.Decimal(18, 2)
  currency        String          @default("MNT")
  idempotencyKey  String          @unique
  postingBatchId  String
  description     String
  metadata        Json?
  occurredAt      DateTime        @default(now())
  createdAt       DateTime        @default(now())

  debitAccount  LedgerAccount  @relation("LedgerDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount LedgerAccount  @relation("LedgerCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: Restrict)
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([debitAccountId, occurredAt])
  @@index([creditAccountId, occurredAt])
  @@index([collaborationId, occurredAt])
  @@index([paymentId])
  @@index([postingBatchId])
}

model ReconciliationRun {
  id             String               @id @default(cuid())
  provider       String
  status         ReconciliationStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  providerTotal  Decimal?             @db.Decimal(18, 2)
  ledgerTotal    Decimal?             @db.Decimal(18, 2)
  discrepancy    Decimal?             @db.Decimal(18, 2)
  checkedRecords Int                  @default(0)
  mismatchCount  Int                  @default(0)
  details        Json?
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  createdAt      DateTime             @default(now())

  @@unique([provider, periodStart, periodEnd])
  @@index([status, createdAt])
}

model PublishProof {
  id              String             @id @default(cuid())
  collaborationId String
  deliverableId   String?
  submittedById   String
  socialAccountId String?
  screenshotId    String?
  postUrl         String
  platform        SocialPlatform
  status          PublishProofStatus @default(SUBMITTED)
  metrics         Json?
  providerPostId  String?
  publishedAt     DateTime?
  verifiedAt      DateTime?
  retentionDueAt  DateTime?
  lastCheckedAt   DateTime?
  failureReason   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  collaboration   Collaboration                @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  deliverable     Deliverable?                 @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  submittedBy     User                         @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  socialAccount   SocialAccount?               @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  screenshot      MediaAsset?                  @relation(fields: [screenshotId], references: [id], onDelete: SetNull)
  metricSnapshots PublishProofMetricSnapshot[]

  @@index([collaborationId, status])
  @@index([retentionDueAt, status])
  @@index([socialAccountId, createdAt])
}

model PublishProofMetricSnapshot {
  id         String   @id @default(cuid())
  proofId    String
  reach      Int?
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  engagement Int?
  isLive     Boolean
  source     String
  capturedAt DateTime @default(now())

  proof PublishProof @relation(fields: [proofId], references: [id], onDelete: Cascade)

  @@index([proofId, capturedAt])
}

model OutboxEvent {
