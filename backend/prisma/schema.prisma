generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Authentication and account

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  username        String?       @unique
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  phone           String?
  location        String?
  bio             String?
  sessionVersion  Int           @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil       DateTime?
  roles           UserRole[]    @default([VIEWER])
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  creatorProfile             CreatorProfile?
  businessProfile            BusinessProfile?
  businessMemberships        BusinessMember[]
  authTokens                 AuthToken[]
  authIdentities             AuthIdentity[]
  verificationCodes          VerificationCode[]
  conversationMembers        ConversationMember[]
  messages                   Message[]
  sentMessageRequests        MessageRequest[]        @relation("MessageRequestSender")
  receivedMessageRequests    MessageRequest[]        @relation("MessageRequestRecipient")
  notifications              Notification[]
  notificationPreference     NotificationPreference?
  collections                Collection[]
  following                  Follow[]
  savedItems                 SavedItem[]
  recentViews                RecentView[]
  shareEvents                ShareEvent[]
  showcaseReactions          ShowcaseReaction[]
  contentReactions           ContentReaction[]
  blocks                     UserBlock[]
  mutedChannels              ChannelMute[]
  reviewsWritten             Review[]                @relation("ReviewAuthor")
  reviewsReceived            Review[]                @relation("ReviewSubject")
  deliverables               Deliverable[]
  analyticsEvents            AnalyticsEvent[]
  reportedCases              TrustCase[]             @relation("CaseReporter")
  assignedCases              TrustCase[]             @relation("CaseAssignee")
  adminActions               AdminAction[]           @relation("AdminActor")
  permissions                UserPermission[]        @relation("PermissionSubject")
  permissionGrants           UserPermission[]        @relation("PermissionGrantor")
  platformSettingsUpdated    PlatformSetting[]       @relation("PlatformSettingUpdater")
  featureFlagsUpdated        FeatureFlag[]           @relation("FeatureFlagUpdater")
  moderatedContentPosts      ContentPost[]           @relation("ContentPostModerator")
  mediaAssets                MediaAsset[]
  campaignAttachments        CampaignAttachment[]
  offerRevisions             OfferRevision[]
  agreementVersions          AgreementVersion[]
  collaborationTasks         CollaborationTask[]     @relation("CollaborationTaskCreatedBy")
  assignedCollaborationTasks CollaborationTask[]     @relation("CollaborationTaskAssignee")
  collaborationFiles         CollaborationFile[]
  collaborationEvents        CollaborationActivity[]
  paymentMethods             PaymentMethod[]
  paymentRefunds             PaymentRefund[]
  paymentPayouts             PaymentPayout[]
  payoutAccounts             PayoutAccount[]
  ledgerAccounts             LedgerAccount[]
  walletTopUps               WalletTopUp[]
  publishProofs              PublishProof[]
  showcaseConsents           ShowcaseConsent[]
  socialOAuthStates          SocialOAuthState[]

  @@index([status, createdAt])
}

model AuthIdentity {
  id        String       @id @default(cuid())
  userId    String
  provider  AuthProvider
  subject   String
  email     String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model AuthToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  jti          String    @unique
  familyId     String
  replacedById String?   @unique
  createdByIp  String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy AuthToken?  @relation("AuthTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   AuthToken[] @relation("AuthTokenRotation")

  @@index([userId])
  @@index([userId, familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model VerificationCode {
  id                String              @id @default(cuid())
  userId            String
  codeHash          String
  purpose           VerificationPurpose @default(EMAIL_VERIFICATION)
  attempts          Int                 @default(0)
  expiresAt         DateTime
  resendAvailableAt DateTime            @default(now())
  consumedAt        DateTime?
  createdAt         DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Creator and business channels

model CreatorProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  channelName         String
  slug                String             @unique
  bio                 String?
  location            String?
  categories          String[]           @default([])
  skills              String[]           @default([])
  languages           String[]           @default([])
  audienceDescription String?
  contentFormat       String?
  startingRate        Decimal?           @db.Decimal(18, 2)
  rates               Json?
  publicRates         Boolean            @default(true)
  currency            String             @default("MNT")
  avatarUrl           String?
  coverUrl            String?
  availability        String?
  metadata            Json?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  availableForWork    Boolean            @default(true)
  ratingAverage       Decimal?           @db.Decimal(3, 2)
  ratingCount         Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialAccounts      SocialAccount[]
  portfolioItems      PortfolioItem[]
  proposals           Proposal[]
  receivedOffers      WorkOffer[]
  collaborations      Collaboration[]
  showcasePosts       ShowcasePost[]
  contentPosts        ContentPost[]        @relation("ContentPostCreatorAuthor")
  partnerContentPosts ContentPost[]        @relation("ContentPostPartnerCreator")
  shortlistEntries    CreatorShortlist[]
  comparisonEntries   CreatorComparison[]
  invitations         CampaignInvitation[]

  @@index([verificationStatus, availableForWork])
  @@index([channelName])
  @@index([location])
  @@index([startingRate])
  @@index([ratingAverage])
  @@index([categories], type: Gin)
}

model BusinessProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  companyName        String
  slug               String             @unique
  description        String?
  industry           String?
  location           String?
  website            String?
  companySize        String?
  contactEmail       String?
  preferences        Json?
  logoUrl            String?
  coverUrl           String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  ratingAverage      Decimal?           @db.Decimal(3, 2)
  ratingCount        Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns           Campaign[]
  sentOffers          WorkOffer[]
  collaborations      Collaboration[]
  shortlistEntries    CreatorShortlist[]
  comparisons         CreatorComparison[]
  invitations         CampaignInvitation[]
  contentPosts        ContentPost[]        @relation("ContentPostBusinessAuthor")
  partnerContentPosts ContentPost[]        @relation("ContentPostPartnerBusiness")
  socialAccounts      SocialAccount[]
  members             BusinessMember[]

  @@index([verificationStatus, createdAt])
  @@index([companyName])
  @@index([industry])
  @@index([location])
  @@index([ratingAverage])
}

model BusinessMember {
  id         String                 @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole     @default(MEMBER)
  status     BusinessMemberStatus   @default(INVITED)
  invitedBy String?
  joinedAt   DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, role, status])
}

model SocialAccount {
  id                    String             @id @default(cuid())
  creatorId             String?
  businessId            String?
  platform              SocialPlatform
  handle                String
  profileUrl            String?
  providerAccountId     String?
  providerPageId        String?
  accessTokenEncrypted  String?            @db.Text
  refreshTokenEncrypted String?            @db.Text
  tokenExpiresAt        DateTime?
  followerCount         Int                @default(0)
  engagementRate        Decimal?           @db.Decimal(6, 3)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  syncStatus            SocialSyncStatus   @default(MANUAL)
  lastSyncAt            DateTime?
  syncError             String?
  connectedAt           DateTime?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  creator       CreatorProfile?    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  business      BusinessProfile?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stats         SocialStat[]
  mediaItems    SocialMediaItem[]
  publishProofs PublishProof[]
  oauthStates   SocialOAuthState[]

  @@unique([platform, handle])
  @@unique([creatorId, platform])
  @@unique([businessId, platform])
  @@unique([platform, providerAccountId])
  @@index([platform, followerCount])
  @@index([syncStatus, lastSyncAt])
  @@index([businessId, platform])
}

model SocialStat {
  id              String   @id @default(cuid())
  socialAccountId String
  followerCount   Int
  followingCount  Int?
  mediaCount      Int?
  reach           Int?
  impressions     Int?
  engagementCount Int?
  engagementRate  Decimal? @db.Decimal(8, 4)
  raw             Json?
  capturedAt      DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt(sort: Desc)])
}

model SocialOAuthState {
  id                    String            @id @default(cuid())
  userId                String
  provider              SocialPlatform
  channelType           SocialChannelType @default(CREATOR)
  tokenHash             String            @unique
  selectionTokenHash    String?           @unique
  accessTokenEncrypted  String?           @db.Text
  refreshTokenEncrypted String?           @db.Text
  tokenExpiresAt        DateTime?
  candidates            Json?
  redirectTo            String?
  expiresAt             DateTime
  consumedAt            DateTime?
  resultAccountId       String?
  createdAt             DateTime          @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resultAccount SocialAccount? @relation(fields: [resultAccountId], references: [id], onDelete: SetNull)

  @@index([userId, provider, expiresAt])
  @@index([selectionTokenHash, expiresAt])
}

model SocialMediaItem {
  id              String    @id @default(cuid())
  socialAccountId String
  externalMediaId String
  mediaType       String
  caption         String?
  permalink       String?
  thumbnailUrl    String?
  mediaUrl        String?
  publishedAt     DateTime?
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount SocialAccount             @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  stats         SocialMediaStatSnapshot[]

  @@unique([socialAccountId, externalMediaId])
  @@index([socialAccountId, publishedAt(sort: Desc)])
}

model SocialMediaStatSnapshot {
  id           String   @id @default(cuid())
  mediaItemId  String
  likeCount    Int?
  commentCount Int?
  savedCount   Int?
  shareCount   Int?
  reach        Int?
  impressions  Int?
  plays        Int?
  capturedAt   DateTime @default(now())

  mediaItem SocialMediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@index([mediaItemId, capturedAt(sort: Desc)])
}

model SocialWebhookEvent {
  id          String    @id @default(cuid())
  eventHash   String    @unique
  provider    String
  objectType  String?
  entryCount  Int       @default(0)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([provider, receivedAt(sort: Desc)])
}

model PortfolioItem {
  id              String          @id @default(cuid())
  creatorId       String
  mediaAssetId    String?
  collaborationId String?         @unique
  title           String
  description     String?
  category        String?
  mediaType       MediaType
  mediaUrl        String
  thumbnailUrl    String?
  statistics      Json?
  status          PortfolioStatus @default(PUBLISHED)
  verified        Boolean         @default(false)
  sortOrder       Int             @default(0)
  publishedAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator       CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  showcasePosts ShowcasePost[]
  contentPosts  ContentPost[]

  @@index([creatorId, status, sortOrder])
  @@index([creatorId, deletedAt, createdAt])
}

model MediaAsset {
  id           String       @id @default(cuid())
  ownerId      String
  purpose      MediaPurpose
  storageKey   String       @unique
  url          String
  originalName String
  mimeType     String
  sizeBytes    Int
  checksum     String
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  portfolioItems      PortfolioItem[]
  collaborationFiles  CollaborationFile[]
  deliverables        Deliverable[]
  publishProofs       PublishProof[]
  contentMedia        ContentMedia[]       @relation("ContentMediaAsset")
  contentThumbnails   ContentMedia[]       @relation("ContentMediaThumbnail")
  contentAudioPosts   ContentPost[]        @relation("ContentPostAudio")
  campaignAttachments CampaignAttachment[]

  @@index([ownerId, purpose, createdAt])
  @@index([deletedAt])
}

// Campaign, proposal and initial work offer

model Campaign {
  id           String           @id @default(cuid())
  businessId   String
  title        String
  slug         String           @unique
  description  String
  category     String
  platforms    SocialPlatform[] @default([])
  budgetMin    Decimal?         @db.Decimal(18, 2)
  budgetMax    Decimal?         @db.Decimal(18, 2)
  currency     String           @default("MNT")
  deadline     DateTime?
  requirements Json?
  status       CampaignStatus   @default(DRAFT)
  isPublic     Boolean          @default(false)
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  business         BusinessProfile      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  proposals        Proposal[]
  offers           WorkOffer[]
  collaborations   Collaboration[]
  shortlistEntries CreatorShortlist[]
  comparisons      CreatorComparison[]
  invitations      CampaignInvitation[]
  contentPosts     ContentPost[]

  goal                String?
  deliverables        Json?
  applicationDeadline DateTime?
  version             Int       @default(1)
  archivedAt          DateTime?
  productSupport      Json?

  attachments CampaignAttachment[]

  @@index([businessId, status])
  @@index([status, category, publishedAt])
  @@index([deadline])
}

model CampaignAttachment {
  id           String                 @id @default(cuid())
  campaignId   String
  uploadedById String
  mediaAssetId String?
  name         String
  url          String
  mimeType     String?
  sizeBytes    Int?
  kind         CampaignAttachmentKind @default(BRIEF)
  createdAt    DateTime               @default(now())

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([mediaAssetId])
}

model Proposal {
  id             String         @id @default(cuid())
  campaignId     String
  creatorId      String
  amount         Decimal?       @db.Decimal(18, 2)
  currency       String         @default("MNT")
  timeline       String?
  message        String?
  deliverables   Json?
  counterAmount  Decimal?       @db.Decimal(18, 2)
  counterMessage String?
  status         ProposalStatus @default(SUBMITTED)
  submittedAt    DateTime       @default(now())
  version        Int            @default(1)
  updatedAt      DateTime       @updatedAt

  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([campaignId, creatorId])
  @@index([creatorId, status])
  @@index([campaignId, status])
}

model WorkOffer {
  id            String                   @id @default(cuid())
  sourceType    WorkOfferSource          @default(DIRECT)
  sourceId      String?
  businessId    String
  creatorId     String
  campaignId    String?
  title         String
  contentType   String
  budget        Decimal
  paymentType   CollaborationPaymentType @default(PAID)
  barterDetails Json?
  currency      String                   @default("MNT")
  timeline      String
  message       String?
  counterTerms  Json?
  finalTerms    Json?
  status        OfferStatus              @default(PENDING_CREATOR_RESPONSE)
  respondedAt   DateTime?
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  business      BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator       CreatorProfile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaign      Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  collaboration Collaboration?
  revisions     OfferRevision[]

  @@unique([sourceType, sourceId])
  @@index([creatorId, status])
  @@index([businessId, status])
}

model OfferRevision {
  id        String   @id @default(cuid())
  offerId   String
  actorId   String
  version   Int
  action    String
  snapshot  Json
  note      String?
  createdAt DateTime @default(now())

  offer WorkOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  actor User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([offerId, version])
  @@index([offerId, createdAt])
}

// Collaboration workspace and contract

model Collaboration {
  id                          String                   @id @default(cuid())
  offerId                     String?                  @unique
  campaignId                  String?
  businessId                  String
  creatorId                   String
  status                      CollaborationStatus      @default(NEGOTIATION)
  progress                    Int                      @default(0)
  version                     Int                      @default(1)
  termsVersion                Int                      @default(1)
  terms                       Json
  paymentType                 CollaborationPaymentType @default(PAID)
  cashAmount                  Decimal                  @default(0) @db.Decimal(18, 2)
  barterEstimatedValue        Decimal?                 @db.Decimal(18, 2)
  barterDetails               Json?
  tasks                       Json?
  files                       Json?
  timeline                    Json?
  activity                    Json?
  creatorAgreementApprovedAt  DateTime?
  businessAgreementApprovedAt DateTime?
  autoApprovalDueAt           DateTime?
  settlementDueAt             DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  offer             WorkOffer?              @relation(fields: [offerId], references: [id], onDelete: SetNull)
  campaign          Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  business          BusinessProfile         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  creator           CreatorProfile          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  contract          Contract?
  deliverables      Deliverable[]
  conversation      Conversation?
  payments          Payment[]
  reviews           Review[]
  agreementVersions AgreementVersion[]
  workspaceTasks    CollaborationTask[]
  workspaceFiles    CollaborationFile[]
  activities        CollaborationActivity[]
  showcasePost      ShowcasePost?
  publishProofs     PublishProof[]
  showcaseConsents  ShowcaseConsent[]
  ledgerEntries     LedgerEntry[]
  platformRevenue   PlatformRevenue[]
  contentPosts      ContentPost[]
  portfolioItem     PortfolioItem?

  @@index([businessId, status])
  @@index([creatorId, status])
  @@index([campaignId])
}

model AgreementVersion {
  id                 String    @id @default(cuid())
  collaborationId    String
  createdById        String
  version            Int
  terms              Json
  changeNote         String?
  lockedAt           DateTime?
  creatorApprovedAt  DateTime?
  businessApprovedAt DateTime?
  createdAt          DateTime  @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([collaborationId, version])
  @@index([collaborationId, createdAt])
}

model CollaborationTask {
  id              String                    @id @default(cuid())
  collaborationId String
  createdById     String
  assigneeId      String?
  title           String
  description     String?
  ownerRole       String
  status          CollaborationTaskStatus   @default(TODO)
  priority        CollaborationTaskPriority @default(MEDIUM)
  sortOrder       Int                       @default(0)
  version         Int                       @default(1)
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("CollaborationTaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee      User?         @relation("CollaborationTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([collaborationId, status, sortOrder])
  @@index([assigneeId, status])
}

model CollaborationFile {
  id              String   @id @default(cuid())
  collaborationId String
  uploadedById    String
  mediaAssetId    String?
  name            String
  url             String
  mimeType        String?
  sizeBytes       Int?
  kind            String   @default("PROJECT")
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  mediaAsset    MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([collaborationId, createdAt])
}

model CollaborationActivity {
  id              String   @id @default(cuid())
  collaborationId String
  actorId         String?
  type            String
  message         String
  metadata        Json?
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  actor         User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([collaborationId, createdAt])
}

model Contract {
  id                    String         @id @default(cuid())
  collaborationId       String         @unique
  status                ContractStatus @default(DRAFT)
  currentVersion        Int            @default(1)
  creatorSignedAt       DateTime?
  businessSignedAt      DateTime?
  activatedAt           DateTime?
  terminatedAt          DateTime?
  revisionLimit         Int            @default(2)
  publishBy             DateTime?
  publishReminderSentAt DateTime?
  retentionDays         Int            @default(30)
  disputeWindowDays     Int            @default(7)
  disclosureRequired    Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  collaboration Collaboration     @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  versions      ContractVersion[]

  @@index([status, updatedAt])
}

model ContractVersion {
  id                 String    @id @default(cuid())
  contractId         String
  version            Int
  terms              Json
  documentUrl        String?
  changeNote         String?
  createdById        String?
  creatorApprovedAt  DateTime?
  businessApprovedAt DateTime?
  createdAt          DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, version])
  @@index([contractId, createdAt])
}

model Deliverable {
  id              String            @id @default(cuid())
  collaborationId String
  uploadedById    String
  mediaAssetId    String?
  title           String
  note            String?
  fileUrl         String
  fileType        String?
  version         Int               @default(1)
  revisionOfId    String?
  status          DeliverableStatus @default(SUBMITTED)
  reviewNote      String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  collaboration Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  mediaAsset    MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  revisionOf    Deliverable?   @relation("DeliverableRevisions", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions     Deliverable[]  @relation("DeliverableRevisions")
  publishProofs PublishProof[]

  @@index([collaborationId, status])
  @@index([mediaAssetId])
}

// Messaging and notifications

model Conversation {
  id              String   @id @default(cuid())
  collaborationId String?  @unique
  directKey       String?  @unique
  title           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  collaboration   Collaboration?       @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  members         ConversationMember[]
  messages        Message[]
  messageRequests MessageRequest[]
}

model MessageRequest {
  id             String               @id @default(cuid())
  senderId       String
  recipientId    String
  senderRole     String
  recipientRole  String
  conversationId String?
  initialMessage String               @db.Text
  status         MessageRequestStatus @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  sender       User          @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User          @relation("MessageRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([recipientId, status, createdAt(sort: Desc)])
  @@index([senderId, status, createdAt(sort: Desc)])
  @@index([senderId, recipientId, status])
}

model ConversationMember {
