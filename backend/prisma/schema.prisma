// Canonical social content. ShowcasePost remains as a compatibility model for
// completed-work publishing while all new creator/business posts use this model.
model ContentPost {
  id                     String             @id @default(cuid())
  authorType             ContentAuthorType
  creatorId              String?
  businessId             String?
  postType               ContentPostType    @default(ORIGINAL)
  title                  String?
  caption                String
  storyStyle             Json?
  audioAssetId           String?
  audioTitle             String?
  audioArtist            String?
  audioStartMs           Int                @default(0)
  audioVolume            Decimal?           @db.Decimal(4, 3)
  audioRightsConfirmedAt DateTime?
  category               String?
  visibility             ContentVisibility  @default(PUBLIC)
  status                 ContentPostStatus  @default(DRAFT)
  campaignId             String?
  portfolioItemId        String?
  collaborationId        String?
  paidPartnership        Boolean            @default(false)
  partnerCreatorId       String?
  partnerBusinessId      String?
  publishedAt            DateTime?
  expiresAt              DateTime?
  archivedAt             DateTime?
  deletedAt              DateTime?
  hiddenAt               DateTime?
  hiddenReason           String?
  hiddenById             String?
  statusBeforeHide       ContentPostStatus?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  creator         CreatorProfile?   @relation("ContentPostCreatorAuthor", fields: [creatorId], references: [id], onDelete: Cascade)
  business        BusinessProfile?  @relation("ContentPostBusinessAuthor", fields: [businessId], references: [id], onDelete: Cascade)
  partnerCreator  CreatorProfile?   @relation("ContentPostPartnerCreator", fields: [partnerCreatorId], references: [id], onDelete: SetNull)
  partnerBusiness BusinessProfile?  @relation("ContentPostPartnerBusiness", fields: [partnerBusinessId], references: [id], onDelete: SetNull)
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  portfolioItem   PortfolioItem?    @relation(fields: [portfolioItemId], references: [id], onDelete: SetNull)
  collaboration   Collaboration?    @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  media           ContentMedia[]
  audioAsset      MediaAsset?       @relation("ContentPostAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  reactions       ContentReaction[]
  hiddenBy        User?             @relation("ContentPostModerator", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([status, visibility, publishedAt, id])
  @@index([postType, status, expiresAt])
  @@index([category, status, publishedAt])
  @@index([creatorId, status, createdAt])
  @@index([businessId, status, createdAt])
  @@index([campaignId])
  @@index([collaborationId])
  @@index([hiddenAt, status])
  @@index([audioAssetId])
}

model ContentMedia {
  id               String    @id @default(cuid())
  postId           String
  mediaAssetId     String
  thumbnailAssetId String?
  mediaType        MediaType
  sortOrder        Int       @default(0)
  altText          String?
  width            Int?
  height           Int?
  durationMs       Int?
  createdAt        DateTime  @default(now())

  post       ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset  @relation("ContentMediaAsset", fields: [mediaAssetId], references: [id], onDelete: Cascade)
  thumbnail  MediaAsset? @relation("ContentMediaThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@unique([postId, mediaAssetId])
  @@index([postId, sortOrder])
  @@index([mediaAssetId])
}

model ContentReaction {
  id        String              @id @default(cuid())
  userId    String
  postId    String
  type      ContentReactionType @default(LIKE)
  createdAt DateTime            @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

