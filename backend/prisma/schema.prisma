  nextAttemptAt  DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([processedAt, deadLetteredAt, nextAttemptAt])
  @@index([topic, aggregateId])
}

model Review {
