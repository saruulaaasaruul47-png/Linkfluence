# Public Render configuration for https://linkfluence.onrender.com.
# Paste the keys into Render Environment and replace every <...> value there.
# Never commit the real secret values from the Render dashboard.
NODE_ENV=production
CLIENT_URL=https://linkfluence-eight.vercel.app
API_PUBLIC_URL=https://linkfluence.onrender.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

DATABASE_URL=<render-postgresql-connection-string>
JWT_ACCESS_SECRET=<at-least-32-random-characters>
JWT_REFRESH_SECRET=<different-at-least-32-random-characters>
JWT_PASSWORD_RESET_SECRET=<third-different-at-least-32-random-characters>
MEDIA_SIGNING_SECRET=<fourth-different-at-least-32-random-characters>
PAYOUT_ACCOUNT_ENCRYPTION_KEY=<32-byte-base64-or-64-character-hex>
SOCIAL_TOKEN_ENCRYPTION_KEY=<different-32-byte-base64-or-64-character-hex>

RESEND_API_KEY=<resend-api-key>
RESEND_FROM_EMAIL=Influence Hub <no-reply@your-verified-domain.com>
GOOGLE_CLIENT_ID=542984356683-jh7kfd4vfev873v2s1hqu15l146p16jj.apps.googleusercontent.com

PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=<stripe-secret-key-starting-with-sk_>
STRIPE_WEBHOOK_SECRET=<stripe-endpoint-secret-starting-with-whsec_>

# Use sandbox until the Meta app, callbacks and App Review are ready. Change to
# meta only after setting every META_* secret below in Render.
SOCIAL_PROVIDER_MODE=sandbox
META_APP_ID=<meta-app-id>
META_APP_SECRET=<meta-app-secret>
META_GRAPH_VERSION=v23.0
META_INSTAGRAM_REDIRECT_URI=https://linkfluence.onrender.com/api/v1/social-connections/instagram/callback
META_FACEBOOK_REDIRECT_URI=https://linkfluence.onrender.com/api/v1/social-connections/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=<at-least-32-random-characters>

# Leave these unset unless the URLs point to hosted services reachable by Render.
RABBITMQ_URL=
REDIS_URL=

# Render's local filesystem is ephemeral. Keep local only for a temporary demo;
# use s3 plus the S3_* values below for persistent uploaded content.
MEDIA_STORAGE_DRIVER=local
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

