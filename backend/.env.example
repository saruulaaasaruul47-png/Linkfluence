NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/influence_hub?schema=public
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/influence_hub_test?schema=public

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-at-least-32-character-secret
JWT_REFRESH_SECRET=replace-with-different-at-least-32-character-secret
JWT_PASSWORD_RESET_SECRET=replace-with-another-at-least-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=10m

BCRYPT_SALT_ROUNDS=12

REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=26214400

RESEND_API_KEY=
RESEND_FROM_EMAIL=Influence Hub <noreply@example.com>

PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-character-payment-secret

# Used only by `npm run seed:admin`; never commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=Influence Hub Admin

# Used only by `npm run seed:demo-accounts`.
DEMO_CREATOR_EMAIL=creator@example.com
DEMO_CREATOR_PASSWORD=replace-with-a-strong-creator-password
DEMO_BUSINESS_EMAIL=business@example.com
DEMO_BUSINESS_PASSWORD=replace-with-a-strong-business-password

# Used only by `npm run seed:marketplace`.
MARKETPLACE_SEED_PASSWORD=replace-with-a-strong-seed-password
