NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:password@localhost:5432/influence_hub?schema=public
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/influence_hub_test?schema=public

CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=replace-with-at-least-32-character-secret
JWT_REFRESH_SECRET=replace-with-different-at-least-32-character-secret
JWT_PASSWORD_RESET_SECRET=replace-with-another-at-least-32-character-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=10m

BCRYPT_SALT_ROUNDS=12

REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MEDIA_MAX_IMAGE_BYTES=8388608
MEDIA_MAX_VIDEO_BYTES=26214400
MEDIA_MAX_DOCUMENT_BYTES=15728640
MEDIA_MAX_AUDIO_BYTES=12582912
MEDIA_SIGNING_SECRET=replace-with-a-different-at-least-32-character-secret
MEDIA_SIGNED_URL_TTL_SECONDS=300
# Production must use persistent object storage. Supports AWS S3, Cloudflare R2,
# MinIO and other S3-compatible providers.
MEDIA_STORAGE_DRIVER=local
S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

RESEND_API_KEY=
# Development registrations that use RFC-reserved recipients such as user@example.com
# are delivered to the local console instead of Resend. Real recipients use Resend.
RESEND_FROM_EMAIL=Influence Hub <onboarding@resend.dev>

# Google Identity Services Web client ID. Use the same value in frontend/.env.
GOOGLE_CLIENT_ID=

# Development can use the mock provider for instant demo wallet credits. Production
# remains fail-closed and requires Stripe Checkout plus a verified signed webhook.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-32-character-payment-secret
PAYMENT_COMMISSION_PERCENT=10
PAYOUT_MINIMUM_AMOUNT=50000
DELIVERABLE_AUTO_APPROVAL_DAYS=7
PAYOUT_ACCOUNT_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-character-hex-key

# Required only when PAYMENT_PROVIDER=qpay.
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_TOKEN=replace-with-at-least-32-random-characters

# Hosted Stripe Checkout + signed webhook. Set PAYMENT_PROVIDER=stripe to enable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Day 5 realtime and durable event infrastructure. Leave blank only for local in-memory development.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379
QUEUE_MAX_ATTEMPTS=5
QUEUE_RETRY_BASE_MS=1000
OUTBOX_POLL_MS=1000

# Structured request latency warning threshold and p95 smoke target.
SLOW_REQUEST_THRESHOLD_MS=750

# Social OAuth and verified creator statistics. Use `sandbox` locally and `meta` in production.
API_PUBLIC_URL=http://localhost:3000
SOCIAL_PROVIDER_MODE=sandbox
SOCIAL_TOKEN_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-or-64-character-hex-key
SOCIAL_SYNC_STALE_HOURS=24
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Legacy shared callback remains supported; provider-specific callbacks take precedence.
META_REDIRECT_URI=http://localhost:3000/api/v1/social-connections/instagram/callback
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/social-connections/instagram/callback
META_FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/social-connections/facebook/callback
META_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters

# Used only by `npm run seed:admin`; never commit a real password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=Influence Hub Admin

# Used only by `npm run seed:demo-accounts`.
DEMO_CREATOR_EMAIL=creator@example.com
DEMO_CREATOR_PASSWORD=replace-with-a-strong-creator-password
DEMO_BUSINESS_EMAIL=business@example.com
DEMO_BUSINESS_PASSWORD=replace-with-a-strong-business-password

# Used only by `npm run seed:marketplace`.
MARKETPLACE_SEED_PASSWORD=replace-with-a-strong-seed-password
